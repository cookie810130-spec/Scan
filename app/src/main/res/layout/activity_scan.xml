<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F9FD">

    <LinearLayout
        android:id="@+id/layoutScannerSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F3F9FD">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="#DDF3FF">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="大樹點貨掃描器"
                android:textColor="#075985"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModePoint"
                android:layout_width="70dp"
                android:layout_height="38dp"
                android:text="點貨"
                android:textSize="12sp"
                android:textColor="#075985"
                app:backgroundTint="#BAE6FD"
                app:cornerRadius="9dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeInventory"
                android:layout_width="70dp"
                android:layout_height="38dp"
                android:layout_marginStart="5dp"
                android:text="盤點"
                android:textSize="12sp"
                android:textColor="#075985"
                app:backgroundTint="#BAE6FD"
                app:cornerRadius="9dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvDbStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="雲端　讀取中..."
                android:textColor="#0369A1"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshDb"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="🔄 更新資料庫"
                android:textColor="#075985"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#BAE6FD"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoom"
                android:layout_width="52dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="縮放"
                android:textColor="#075985"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#BAE6FD"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#102A43"
                    app:implementationMode="compatible"
                    app:scaleType="fillCenter" />
                <View
                    android:layout_width="220dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_frame" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:text="將一維條碼對準中央框線"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="#66000000"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="請按「開始掃描」"
                android:textColor="#0369A1"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="品項 0 種　｜　總數 0 件"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">
            <TextView
                android:id="@+id/tvLastItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="最後點貨&#10;尚未掃描"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每次數量"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etQty"
                android:layout_width="70dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_qty"
                android:gravity="center"
                android:inputType="numberSigned"
                android:text="1"
                android:textColor="#0369A1"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="件"
                android:textColor="#64748B"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/etManualCode"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_qty"
                android:hint="手動輸入編碼"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#0369A1"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="核對清單"
                android:textColor="#075985"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#BAE6FD"
                app:cornerRadius="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:text="清空"
                android:textColor="#0369A1"
                android:textSize="14sp"
                app:backgroundTint="#DDF3FF"
                app:cornerRadius="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="開始掃描"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#0284C7"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="3dp"
            android:paddingBottom="5dp"
            android:text="已點貨品項"
            android:textColor="#075985"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:background="#F3F9FD" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutInventorySection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F3F9FD"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#DDF3FF">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="盤點模式"
                android:textColor="#075985"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvInventorySummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已掃描 0 項"
                android:textColor="#0369A1"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:layout_margin="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.camera.view.PreviewView
                    android:id="@+id/inventoryPreviewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#102A43"
                    app:implementationMode="compatible"
                    app:scaleType="fillCenter" />
                <View
                    android:layout_width="220dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_frame" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:text="掃描一維條碼"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="#66000000"
                    android:padding="5dp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp">
            <EditText
                android:id="@+id/etInventoryManualCode"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_qty"
                android:hint="手動輸入自編碼／條碼"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#0369A1"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInventoryScan"
                android:layout_width="82dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:text="掃描"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:backgroundTint="#0284C7"
                app:cornerRadius="9dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="#F3F9FD">
            <LinearLayout
                android:id="@+id/inventoryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInventoryClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:text="清空盤點"
                android:textColor="#075985"
                android:textSize="13sp"
                app:backgroundTint="#DDF3FF"
                app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInventoryGenerate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:layout_marginStart="8dp"
                android:text="生成盤點表 PDF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#0284C7"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutReportSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F3F9FD"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#DDF3FF">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="盤點核對"
                android:textColor="#075985"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="相機已關閉"
                android:textColor="#0284C7"
                android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <TextView
                android:id="@+id/tvReportSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="18dp"
                android:text="本次盤點　0 種商品　｜　0 件"
                android:textColor="#0369A1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="#FFFFFF"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/tvReportContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#FFFFFF" />
        </ScrollView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToScan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="14dp"
            android:text="← 返回掃描"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#0284C7"
            app:cornerRadius="14dp" />
    </LinearLayout>
</FrameLayout>
