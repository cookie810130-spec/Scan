<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f4f6f9">

    <!-- 上方相機預覽區 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 下方控制與資訊面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#ffffff"
        android:elevation="8dp">

        <!-- 1. 每次累加數量設定列 (etQty 在這裡) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每次累加數量："
                android:textStyle="bold"
                android:textColor="#475569"
                android:textSize="15sp" />

            <!-- 數量輸入框 (確保有這個 ID) -->
            <EditText
                android:id="@+id/etQty"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@android:drawable/editbox_background_normal"
                android:gravity="center"
                android:inputType="number"
                android:text="1"
                android:textColor="#1e40af"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="請對準條碼掃描"
                android:textColor="#16a34a"
                android:textStyle="bold"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 2. 最後刷入品項資訊 -->
        <TextView
            android:id="@+id/tvLastItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#e0f2fe"
            android:padding="10dp"
            android:text="最後點貨：無"
            android:textColor="#0f172a"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 3. 資料庫狀態與總計 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvDbStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="雲端資料庫: 讀取中…"
                android:textSize="13sp"
                android:textColor="#64748b" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="累計品項：0 種 | 總量：0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1e293b" />
        </LinearLayout>

        <!-- 4. 功能按鈕列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="手動觸發掃描"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清空紀錄"
                android:backgroundTint="#dc2626"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="檢視核對單"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- 5. 已點貨清單列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="#ffffff" />
    </LinearLayout>

</LinearLayout>
