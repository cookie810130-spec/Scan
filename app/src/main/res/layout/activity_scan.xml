<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f4f6f9">

    <!-- 頂部狀態列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1e3a8a"
        android:padding="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvDbStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="資料庫：連線中..."
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 相機預覽 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4" />

    <!-- 掃描狀態與最後一筆紀錄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">
        
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_hint"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#2563eb" />
            
        <TextView
            android:id="@+id/tvLastItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_item_none"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:background="#e0f2fe"
            android:padding="8dp"
            android:textColor="#0f172a" />
    </LinearLayout>

    <!-- 操作按鈕區 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="3">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1.2"
            android:text="掃描"
            android:textSize="18sp"
            android:layout_marginEnd="4dp" />
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReport"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="核對單"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="0.8"
            android:text="清空"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#dc2626" />
    </LinearLayout>

    <!-- 總計文字 -->
    <TextView
        android:id="@+id/tvSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="累計品項：0 種 | 總點貨量：0 件"
        android:padding="8dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#e2e8f0" />

    <!-- 點貨清單 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
